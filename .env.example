# CivicPilot Environment Variables
# Source of truth: docs/CONTRACT.md Section 8

# LLM & Embeddings (Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro
GEMINI_EMBED_MODEL=text-embedding-004
MOCK_LLM=false
CONFIDENCE_THRESHOLD=0.65

# Database (PostgreSQL + pgvector)
# Local: postgresql+asyncpg://postgres:postgres@localhost:5432/civicpilot
# Supabase: postgresql+asyncpg://postgres:[PASSWORD]@[HOST]:[PORT]/postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/civicpilot

# Storage (Supabase Storage with local fallback)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# Authentication & Security
JWT_SECRET=change-this-to-a-very-secure-random-secret-key-32chars
OFFICER_PASSWORD=adminpassword

# Simulation Clock & Demo
# 1 = real-time, 60 = 1 minute is 1 hour
SIM_TIME_SCALE=1

# External Services & Geocoding
NOMINATIM_USER_AGENT=CivicPilot/1.0 (contact: civicpilot@example.com)
RESEND_API_KEY=re_optional_resend_api_key

# Frontend & CORS
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_USE_MOCKS=false
